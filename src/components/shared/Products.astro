---
import boloCorte from "@/assets/bolo-de-corte.png";
import bolo from "@/assets/bolo.jpeg";
import brigadeiroImg from "@/assets/brigadeiro.jpg";
import copinhoSobremesa from "@/assets/copinho-sobremesa.jpeg";
import copinhosImg from "@/assets/copinho.png";
import trufaImg from "@/assets/trufa.jpeg";
import { Image } from "astro:assets";
import { ArrowUpRight } from "lucide-react";

const products = [
  {
    name: "Brigadeiros Gourmet",
    description:
      "Brigadeiros artesanais com diversos sabores e coberturas especiais",
    image: brigadeiroImg,
    alt: "Bandeja com brigadeiros gourmet artesanais boleados com confeitos variados, incluindo chocolate belga, granulado e castanhas.",
  },
  {
    name: "Bolos de Festa",
    description: "Bolos personalizados para todas as ocasiões especiais",
    image: bolo,
    alt: "Bolo de festa alto e decorado com cobertura cremosa e acabamento sofisticado, ideal para aniversários e celebrações.",
  },
  {
    name: "Copinhos de Chocolate",
    description:
      "Copinhos de chocolate recheados com deliciosos cremes e coberturas",
    image: copinhosImg,
    alt: "Copinhos de chocolate nobre recheados com mousse cremoso e decorados com frutas frescas e raspas de chocolate.",
  },
  {
    name: "Trufas",
    description: "Trufas finas com sabores variados e acabamento sofisticado",
    image: trufaImg,
    alt: "Trufas finas de chocolate com acabamento brilhante e textura aveludada, exibindo recheio cremoso.",
  },
  {
    name: "Copinhos de Sobremesa",
    description: "Copinhos de Sobremesa artesanais com recheios irresistíveis",
    image: copinhoSobremesa,
    alt: "Copinho de sobremesa individual transparente mostrando camadas intercaladas de creme, bolo e recheio generoso.",
  },
  {
    name: "Bolo de Corte",
    description: "Bolo de Corte macio e delicioso",
    image: boloCorte,
    alt: "Fatia de bolo de corte servida no prato, destacando a massa fofinha e camadas úmidas de recheio.",
  },
];
---
<section id="produtos" class="section products">
  <div class="shell">
    <div class="section-heading">
      <h2>Delícias que vão<br />te conquistar.</h2>
      <p>Conheça nossa seleção de doces artesanais, preparados diariamente com ingredientes frescos e muito carinho.</p>
    </div>
    <div class="product-grid">
      {products.map((product) => (
        <article class="product">
          <a class="product-image-link" href={`https://wa.me/5561983357945?text=${encodeURIComponent(`Olá, gostaria de um orçamento de ${product.name}.`)}`} aria-label={`Pedir orçamento: ${product.name}`}>
            <Image src={product.image} alt={product.alt} widths={[400, 640, 960]} sizes="(max-width: 767px) 100vw, 50vw" loading="lazy" />
          </a>
          <div class="product-info">
            <div><h3>{product.name}</h3><p>{product.description}</p></div>
            <a class="product-order" href={`https://wa.me/5561983357945?text=${encodeURIComponent(`Olá, gostaria de um orçamento de ${product.name}.`)}`} aria-label={`Pedir orçamento: ${product.name}`}><ArrowUpRight size={23} strokeWidth={1.7} aria-hidden="true" /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const photos = document.querySelectorAll<HTMLElement>(".product-image-link");

  if (!reduceMotion.matches && "IntersectionObserver" in window) {
    const pending = new Set(photos);
    const animations = new Set<Animation>();
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (!isIntersecting) return;
        observer.unobserve(target);
        pending.delete(target as HTMLElement);

        if (!reduceMotion.matches && !target.matches(":focus-within")) {
          const index = Array.from(photos).indexOf(target as HTMLElement);
          const paired = window.matchMedia("(min-width: 768px)").matches;
          const animation = target.animate(
            [
              { transform: "translateY(18px) scale(.985)", opacity: .72 },
              { transform: "translateY(0) scale(1)", opacity: 1 },
            ],
            { duration: 700, delay: paired ? (index % 2) * 90 : 0, easing: "cubic-bezier(.16, 1, .3, 1)", fill: "backwards" },
          );
          animations.add(animation);
          animation.onfinish = () => animations.delete(animation);
        }
      });
      if (!pending.size) observer.disconnect();
    }, { threshold: .15 });

    photos.forEach((photo) => observer.observe(photo));
    reduceMotion.addEventListener("change", ({ matches }) => {
      if (!matches) return;
      observer.disconnect();
      animations.forEach((animation) => animation.cancel());
      animations.clear();
    });
  }
</script>
