---
import { Star } from "lucide-react";
const testimonials = [
  { name: "Isis Lacerda", text: "Super gostoso! Fora que a dona é sempre muito educada e personaliza tudo com muito carinho. Podem comprar tranquilos", rating: 5 },
  { name: "Joao Paulo", text: "Os melhores doces de Uberlândia! Tudo com muita qualidade e bem frescos, recomendo!", rating: 5 },
  { name: "Aline Lacerda", text: "Doces gostosos demais! eu amei! vou comprar mais vezes", rating: 5 },
];
---
<section id="depoimentos" class="section testimonials">
  <div class="shell">
    <h2>O que nossos<br />clientes dizem.</h2>
    <div class="quotes">
      {testimonials.map((testimonial) => (
        <figure class="quote">
          <div class="stars" role="img" aria-label={`${testimonial.rating} de 5 estrelas`}>
            {Array.from({ length: testimonial.rating }).map(() => <Star size={16} strokeWidth={1.7} fill="currentColor" aria-hidden="true" />)}
          </div>
          <blockquote><p>“{testimonial.text}”</p></blockquote>
          <figcaption>{testimonial.name}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
