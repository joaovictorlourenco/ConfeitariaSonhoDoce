---
import { ArrowUpRight, ChevronDown, MapPin } from "lucide-react";
---
<section id="localizacao" class="section location">
  <div class="shell location-grid">
    <div class="location-copy">
      <h2>Nos encontre<br />em Uberlândia.</h2>
      <p>Visite nossa confeitaria e prove os doces artesanais da Sonho Doce.</p>
      <div class="address"><MapPin size={23} strokeWidth={1.7} aria-hidden="true" /><div><strong>Bairro Brasil</strong><p>Uberlândia, Minas Gerais</p></div></div>
      <dl class="hours">
        <div><dt>Segunda a Sexta</dt><dd>9h às 18h</dd></div>
        <div><dt>Sábado</dt><dd>9h às 14h</dd></div>
        <div><dt>Domingo</dt><dd>Fechado</dd></div>
      </dl>
      <a class="text-link" href="https://share.google/w3I7afZSFN0tiVIwx" target="_blank" rel="noopener noreferrer">Abrir no Google Maps <ArrowUpRight size={18} strokeWidth={1.7} aria-hidden="true" /></a>
    </div>
    <div class="location-map">
      <details class="map-disclosure">
        <summary>
          <MapPin size={40} strokeWidth={1.3} aria-hidden="true" />
          <strong>Sonho Doce</strong>
          <span>Bairro Brasil, Uberlândia</span>
          <span class="map-action">Ver mapa <ChevronDown size={18} strokeWidth={1.7} aria-hidden="true" /></span>
        </summary>
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3774.9825410012127!2d-48.271832100000005!3d-18.8878557!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd4f4d31804e8db9%3A0xbb773007bdb7e83!2sSonho%20Doce!5e0!3m2!1spt-BR!2sbr!4v1764090701024!5m2!1spt-BR!2sbr" width="640" height="480" title="Mapa para Sonho Doce, Bairro Brasil, Uberlândia" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </details>
      <p>Se o mapa não carregar, use o link para abrir no Google Maps.</p>
    </div>
  </div>
</section>
