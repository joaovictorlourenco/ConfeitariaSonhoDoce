---
import heroImg from "@/assets/hero-img.jpg";
import { Image } from "astro:assets";
import { ArrowDown, ArrowUpRight } from "lucide-react";
import { whatsappUrl } from "@/lib/site";
---
<section id="inicio" class="hero">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <h1>Doçura que <span>aquece o coração.</span></h1>
      <p>Doces artesanais feitos com amor e ingredientes selecionados, para transformar seus momentos em boas memórias.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={whatsappUrl}>Faça seu Pedido <ArrowUpRight size={19} strokeWidth={1.7} aria-hidden="true" /></a>
        <a class="text-link" href="#produtos">Ver Produtos <ArrowDown size={17} strokeWidth={1.7} aria-hidden="true" /></a>
      </div>
    </div>
    <div class="hero-visual">
      <Image src={heroImg} alt="Doces artesanais de coco e chocolate em forminhas rosas da Sonho Doce" widths={[480, 768, 1200]} sizes="(max-width: 767px) 100vw, 55vw" loading="eager" fetchpriority="high" class="hero-image" />
    </div>
  </div>
</section>
